    "@testing-library/react": "16.3.3",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "fake-indexeddb": "6.2.8",
    "jsdom": "31.0.1",
    "rolldown": "1.2.19",
    "tailwindcss": "4.3.3",
