{
  "name": "cognotive",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-excalidraw-assets.mjs && node scripts/fetch-semantic-assets.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-excalidraw-assets.mjs && node scripts/fetch-semantic-assets.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test",
    "build:bridge": "node scripts/build-bridge.mjs",
    "bridge": "node scripts/build-bridge.mjs && node bridge/dist/cognotive.mjs bridge",
    "mcp": "node scripts/build-bridge.mjs && node bridge/dist/cognotive.mjs mcp"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
