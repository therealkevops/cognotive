# No variables are needed for phase 0.
# Later phases will add these (set them in Vercel → Project → Settings → Environment Variables):
#
# GITHUB_APP_CLIENT_ID=       # phase 2: GitHub App used for login and repo access
# GITHUB_APP_CLIENT_SECRET=   # phase 2
# SESSION_SECRET=             # phase 2: encrypts the refresh-token cookie
# ALLOWED_GITHUB_USER_IDS=    # phase 5: who may use /api/chat
# ANTHROPIC_API_KEY=          # phase 5: Claude API key for /api/chat
