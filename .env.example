# GitHub sign-in and repository storage (phase 2). See README → "Set up GitHub storage".
# Set these in Vercel → Project → Settings → Environment Variables, or in .env.local for `npm run dev`.

GITHUB_APP_CLIENT_ID=        # from the GitHub App's settings page ("Client ID")
GITHUB_APP_CLIENT_SECRET=    # "Generate a new client secret" on the same page
GITHUB_APP_SLUG=             # the app's URL name, e.g. noted-ai-kev (enables the "Choose repositories" link)
SESSION_SECRET=              # 32+ random characters: openssl rand -base64 32
ALLOWED_GITHUB_USER_IDS=     # comma-separated GitHub user ids allowed to sign in; empty = anyone

# Later phases:
# ANTHROPIC_API_KEY=         # phase 5: Claude API key for /api/chat
